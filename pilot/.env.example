# MeritX private pilot -- example config. Copy to .env (gitignored) or, better,
# keep real values in /workspace/secrets/ or the hosting platform's secret store.
# NEVER commit real emails, names, hashes, client names or case details.

# Hard gate. The server refuses to start unless this is exactly "true".
PRIVATE_MODE=true

# >= 32 bytes. Generate: openssl rand -base64 48
SESSION_SECRET=

# Allowlist: exactly one employee, one lawyer, one enterprise; one or more admin (MeritX ops).
# Pilot plan: 5 accounts = employee + lawyer + enterprise + 2 admins (<admin-1>, <admin-2>).
# Admins see only status, the access log and the read-only account list -- never materials.
# Total must be <= PILOT_MAX_ACCOUNTS (allowed 4-10). Code default if unset: 4.
PILOT_MAX_ACCOUNTS=5
# Optional per account: "enabled": false (keeps the entry, blocks login and ends sessions).
# passwordHash: printf '%s' "$PW" | npm run --silent hash-password
# Prefer PILOT_ACCOUNTS_FILE=/workspace/secrets/meritx_pilot_accounts.json (untracked).
# PILOT_ACCOUNTS=[{"id":"employee","email":"<employee email>","name":"<display name>","role":"employee","passwordHash":"scrypt$..."},{"id":"lawyer","email":"<lawyer email>","name":"<attorney name shown on approved assessments>","role":"lawyer","passwordHash":"scrypt$..."},{"id":"enterprise","email":"<hr email>","name":"<hr name>","role":"enterprise","passwordHash":"scrypt$..."},{"id":"admin1","email":"<admin-1 email>","name":"<admin-1 name>","role":"admin","passwordHash":"scrypt$..."},{"id":"admin2","email":"<admin-2 email>","name":"<admin-2 name>","role":"admin","passwordHash":"scrypt$..."}]
PILOT_ACCOUNTS_FILE=

# Optional: questionnaire prompts, JSON array of {"id","text"} in an untracked file.
PILOT_QUESTIONNAIRE_FILE=

# Private data dir (persistent disk). Must NOT be inside public/.
PILOT_DATA_DIR=./data

# Feature flag: employee sees the eligibility assessment only when ON *and* lawyer-approved.
LAWYER_APPROVED_PUBLISH=false

# Strict CORS allowlist (comma-separated exact origins). Leave empty: UI is same-origin.
PILOT_ALLOWED_ORIGINS=

# ---- PR2: encryption at rest + signed URLs ----
# 32 random bytes, base64: openssl rand -base64 32. Losing it = data unrecoverable; destroying it = crypto-shred.
# Prefer PILOT_ENCRYPTION_KEY_FILE=/workspace/secrets/meritx_pilot_enc.key
PILOT_ENCRYPTION_KEY=
# >= 32 bytes, different from SESSION_SECRET: openssl rand -base64 48 (or DOWNLOAD_URL_SECRET_FILE=...)
DOWNLOAD_URL_SECRET=
# Signed download URL lifetime, 1-300 seconds
DOWNLOAD_URL_TTL_SECONDS=60

# ---- PR2: AI provider (paid API only) ----
# none (default) | gemini | openai | anthropic
AI_PROVIDER=none
# e.g. a current model id from the provider's docs
AI_MODEL=
# Prefer AI_API_KEY_FILE=/workspace/secrets/meritx_pilot_ai.key
AI_API_KEY=
# Must be set to true ONLY after docs/AI_VENDOR_VERIFICATION.md is completed for this exact account/project
AI_PAID_TIER_VERIFIED=false
# Untracked JSON: {"assessment":{"system":"...","user":"... {{visaType}} {{questionnaire}} {{materials}} ..."}}
AI_PROMPTS_FILE=
# Optional regional endpoint override (https only), e.g. https://us.api.openai.com
# AI_BASE_URL=
# AI_TIMEOUT_MS=120000
# AI_MAX_OUTPUT_TOKENS=4096

# ---- PR3: access-log anchoring (docs/AUDIT_ANCHORING.md) ----
# Each append prints {"event":"access_log_anchor",seq,entries,hash} to stdout (Render logs = off-disk anchor). Keep true.
PILOT_ACCESS_LOG_ANCHOR_STDOUT=true
# Optional daily anchor email to the lawyer. DISABLED by default. No provider chosen yet: the MeritX
# owner picks one before launch; credentials go in the host secret store only.
PILOT_ANCHOR_EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false        (true for implicit TLS / port 465; otherwise STARTTLS is required)
# SMTP_USER=
# SMTP_PASSWORD=           (or SMTP_PASSWORD_FILE=/etc/secrets/smtp_password)
# SMTP_FROM=
# SMTP_TO=                 (default: the lawyer account's email)

# Optional
# SESSION_TTL_SECONDS=28800
# MAX_UPLOAD_BYTES=26214400
# SECURE_COOKIES=true   (defaults to true when NODE_ENV=production)
# TRUST_PROXY=true      (defaults to true when NODE_ENV=production)
# PORT=3101
